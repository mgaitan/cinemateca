# Create a Google Cloud OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Set to http://localhost:5173 for Vite development, / for production
WEB_REDIRECT=http://localhost:5173
# Generate: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=
# Optional TMDB API v4 read access token (for posters and synopses)
TMDB_API_TOKEN=
DEFAULT_DRIVE_FOLDER_URL=
SQLITE_PATH=backend/data/cinemateca.sqlite3
# Leave empty for local SQLite; set both to use remote libSQL (Turso)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
APP_ENV=development
COOKIE_SECURE=false
